{
  "lexicon": 1,
  "id": "eu.skycart.store",
  "defs": {
    "main": {
      "type": "record",
      "description": "A shop profile, published in the shop's own repository.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "name",
          "country",
          "imprintUrl",
          "termsUrl",
          "withdrawalPolicyUrl",
          "privacyUrl",
          "shippingInfoUrl",
          "shippingCountries",
          "createdAt"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 1200,
            "maxGraphemes": 120
          },
          "description": {
            "type": "string",
            "maxLength": 20000,
            "maxGraphemes": 2000
          },
          "logo": {
            "type": "blob",
            "accept": [
              "image/*"
            ],
            "maxSize": 1000000
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "Country where the shop is established; must be an EU member state to be listed."
          },
          "imprintUrl": {
            "type": "string",
            "format": "uri"
          },
          "termsUrl": {
            "type": "string",
            "format": "uri"
          },
          "withdrawalPolicyUrl": {
            "type": "string",
            "format": "uri"
          },
          "privacyUrl": {
            "type": "string",
            "format": "uri"
          },
          "shippingInfoUrl": {
            "type": "string",
            "format": "uri"
          },
          "shippingCountries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "description": "ISO 3166-1 alpha-2 country code."
            },
            "minLength": 1
          },
          "proofKey": {
            "type": "string",
            "description": "Optional P-256 public key as multibase Multikey (z...), used to verify purchase proofs on reviews."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
