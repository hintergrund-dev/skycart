{
  "lexicon": 1,
  "id": "eu.skycart.reply",
  "defs": {
    "main": {
      "type": "record",
      "description": "A shop's reply to a review.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "text",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "text": {
            "type": "string",
            "maxLength": 20000,
            "maxGraphemes": 2000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
