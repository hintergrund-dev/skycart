{
  "lexicon": 1,
  "id": "eu.skycart.catalog.searchItems",
  "defs": {
    "main": {
      "type": "query",
      "description": "Search listed items.",
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200
          },
          "category": {
            "type": "string"
          },
          "minPriceCents": {
            "type": "integer",
            "minimum": 0
          },
          "maxPriceCents": {
            "type": "integer",
            "minimum": 0
          },
          "condition": {
            "type": "string",
            "knownValues": [
              "new",
              "used",
              "refurbished"
            ]
          },
          "shipsTo": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "ISO 3166-1 alpha-2 country code."
          },
          "inStock": {
            "type": "boolean",
            "description": "Only in_stock and low_stock items."
          },
          "sort": {
            "type": "string",
            "knownValues": [
              "relevance",
              "priceAsc",
              "priceDesc",
              "newest"
            ],
            "default": "relevance"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "eu.skycart.defs#itemView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
