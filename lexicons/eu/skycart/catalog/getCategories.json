{
  "lexicon": 1,
  "id": "eu.skycart.catalog.getCategories",
  "defs": {
    "main": {
      "type": "query",
      "description": "All categories with labels and counts of listed items.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "categories"
          ],
          "properties": {
            "categories": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "eu.skycart.defs#categoryView"
              }
            }
          }
        }
      }
    }
  }
}
