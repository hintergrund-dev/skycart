{
  "lexicon": 1,
  "id": "eu.skycart.catalog.getStoreItems",
  "defs": {
    "main": {
      "type": "query",
      "description": "Items of one store, newest first.",
      "parameters": {
        "type": "params",
        "required": [
          "store"
        ],
        "properties": {
          "store": {
            "type": "string",
            "description": "DID or handle."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "eu.skycart.defs#itemView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
