{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skycart-appview",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "JETSTREAM_URL": "wss://jetstream2.us-east.bsky.network/subscribe"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "skycart", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "JETSTREAM", "class_name": "Jetstream" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Jetstream"] }],
  "queues": {
    "producers": [{ "binding": "CHECK_QUEUE", "queue": "skycart-store-checks" }],
    "consumers": [{ "queue": "skycart-store-checks", "max_batch_size": 1, "max_retries": 3 }]
  },
  "triggers": { "crons": ["0 3 * * *"] }
}
